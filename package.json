{
  "name": "kakudo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "service:config": "tsx scripts/service-config.ts",
    "backup": "tsx scripts/backup.ts",
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/server/index.mjs",
    "start": "node dist/server/index.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:browser": "tsx scripts/browser-test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build && npm run test:browser",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@hono/node-server": "2.1.1",
    "@openai/codex-sdk": "0.154.0",
    "@tanstack/react-router": "1.170.38",
    "@xyflow/react": "12.11.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "html-to-text": "10.0.1",
    "ipaddr.js": "2.5.0",
    "openai": "7.17.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sanitize-html": "2.17.7",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "type": "module"
}
