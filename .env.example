# Local PoC only. Docker Compose binds PostgreSQL to loopback.
DATABASE_URL=postgresql://kakudo:kakudo@127.0.0.1:54329/kakudo
TEST_DATABASE_URL=postgresql://kakudo:kakudo@127.0.0.1:54330/kakudo_test
E2E_DATABASE_URL=postgresql://kakudo:kakudo@127.0.0.1:54331/kakudo_e2e_test
CONTENT_STORAGE_ROOT=./workspace-data
# Health returns 503 below this available-capacity threshold (default 100 MiB).
STORAGE_MIN_FREE_BYTES=104857600
# PostgreSQL 17 pg_dump / pg_restore directory when not on PATH (backup and its integration test).
# PG_BIN_DIR=/opt/homebrew/opt/libpq/bin

# Hono API / production server. Vite development UI listens on 43170.
HOST=127.0.0.1
PORT=43171
# Exact browser origins; required also for script mutations via the Origin header.
# When publishing, replace these with your HTTPS origin. Host/Forwarded are not trusted.
ALLOWED_ORIGINS=http://127.0.0.1:43170,http://127.0.0.1:43171

# Reviewer: codex (default), openai, or mock (offline tests/demo).
REVIEW_PROVIDER=codex
REVIEW_TIMEOUT_MS=120000
# Per-run execution deadline and maximum queued + running reviews.
REVIEW_RUN_TIMEOUT_MS=600000
REVIEW_MAX_PENDING=10
# Optional: model / executable for the locally authenticated Codex SDK.
# CODEX_MODEL=
# CODEX_PATH=
# Required only with REVIEW_PROVIDER=openai:
# OPENAI_MODEL=
# OPENAI_API_KEY=
# Search fallback: defaults to REVIEW_PROVIDER; codex / openai / mock / none.
# Registered Document -> Node -> Workspace sources are checked first.
# SEARCH_PROVIDER=codex
